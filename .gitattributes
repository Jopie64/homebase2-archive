# Normalise line endings on every platform; the scripts run on Linux/NAS and macOS.
* text=auto eol=lf

*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Shell scripts must stay executable even on filesystems that forget the bit.
*.sh text eol=lf

# Binary media (never archived here, but keep git from ever diffing them)
*.mp4 binary
*.h264 binary
*.aac binary
*.png binary
*.jpg binary
