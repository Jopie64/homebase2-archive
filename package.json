{
  "name": "homebase2-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Archive eufy HomeBase 2 camera recordings to plain MP4 files",
  "keywords": [
    "eufy",
    "homebase",
    "doorbell",
    "archive",
    "p2p",
    "camera"
  ],
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "list": "node sync.mjs --list",
    "sync": "node sync.mjs",
    "verify": "node verify.mjs",
    "stats": "node stats.mjs",
    "config": "node sync.mjs --print-config",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mega-yfue/eufy-sdk": "0.6.0-beta.12"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
